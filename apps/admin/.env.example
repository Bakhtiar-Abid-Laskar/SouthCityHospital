# ==============================================================================
# SOUTH CITY HOSPITAL — ADMIN OPERATIONS PORTAL ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in your Supabase project credentials.
# ==============================================================================

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (Safe in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Server-only secret for administrative tasks & auth bypass)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin JWT Session Secret for signing staff authentication cookies (Mandatory in production, min 32 chars)
JWT_SECRET_KEY=replace_with_a_secure_random_32_character_jwt_secret_in_production
ADMIN_SESSION_SECRET=replace_with_a_secure_random_32_character_jwt_secret_in_production

# ==============================================================================
# PUBLIC SITE URL (REQUIRED IN PRODUCTION — MUST SET IN VERCEL DASHBOARD)
# ==============================================================================
# The canonical origin of the public-facing website.
# Used to build "Live Profile" links in the admin portal and for cache revalidation.
# IMPORTANT: NEXT_PUBLIC_* values are INLINED AT BUILD TIME.
#            After changing this variable you MUST trigger a REDEPLOY.
# Production:  https://southcityhospital.in
# Development: http://localhost:3000  (automatic if this is unset in dev)
NEXT_PUBLIC_SITE_URL=https://southcityhospital.in

# The canonical origin of this admin portal (used for self-referencing URLs)
NEXT_PUBLIC_ADMIN_URL=https://internaladmin.southcityhospital.in

# Shared secret for triggering on-demand cache revalidation on the public site.
# Must match REVALIDATION_SECRET_TOKEN in apps/web/.env.local / Vercel env.
REVALIDATION_SECRET_TOKEN=replace_with_a_secure_random_secret
WEB_APP_URL=https://southcityhospital.in

